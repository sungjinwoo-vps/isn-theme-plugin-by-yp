<?xml version="1.0"?>
<ruleset name="InfoSecNexus">
	<description>WordPress coding standards for InfoSecNexus.</description>
	<file>wp-content/themes/infosecnexus</file>
	<file>wp-content/plugins/infosecnexus-toolkit</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="4"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP">
		<properties>
			<property name="testVersion" value="8.1-"/>
		</properties>
	</rule>
</ruleset>

